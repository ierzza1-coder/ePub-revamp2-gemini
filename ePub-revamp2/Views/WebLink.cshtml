<body>
    
    <button onclick="topFunction()" id="myBtn" title="Go to top"> <i class="fa-solid fa-arrow-up"></i> Go To Top</button>


    <div class="bodyContent-area col-xl-12 row gap-2" style="display:flex; width: 100%; padding-top: 30px;">

        <span class="manual-id" id="currentId" hidden="">1358</span>


        <nav class="nav-bar2 col-xl-2">

            <div class="nav-links2">
                <ul>
                    @{

                        foreach (var children in Model.Children())
                        {
                            <li onclick="getManual(this)" style="cursor:pointer; margin:20px;">
                                <div class="manual-direct" id="manual-direct" style=" margin:5px;">@children.Value("title")</div>


                            </li>
                        }

                    }
                </ul>
            </div>
        </nav>

        <main class="main-content-area2 col-xl-7" style="margin-right: 17%;">

            <div class="content-section2 @firstChild.Value("title") show" id="@firstChild.Value("title")">
                <h2>@firstChild.Value("title")</h2>

                @foreach (var childrenUnderFirstChild in firstChild.Children())
                {
                    <div class="content-section2-inner " id="@childrenUnderFirstChild.Value("title")">

                        <div>
                            @childrenUnderFirstChild.Value("bodyContent")
                        </div>
                    </div>
                }
            </div>


            @foreach (var childstart2 in Model.Children.Skip(1))
            {

                <div class="content-section2 @childstart2.Value("title") hide" id="@childstart2.Value("title")">
                    <h2>@childstart2.Value("title")</h2>

                    @foreach (var childrenUnderChild in childstart2.Children())
                    {
                        <div class="content-section2-inner" id="@childrenUnderChild.Value("title")">


                            <div>
                                @childrenUnderChild.Value("bodyContent")
                            </div>
                        </div>
                    }
                </div>
            }








        </main>


    </div>

</body>

</html>


<script>

    function getManual(element) {
        // Get the clicked title text (trim to avoid whitespace issues)
        const clickedTitle = element.querySelector('.manual-direct').textContent.trim();

        // Hide all content-section2 blocks
        document.querySelectorAll('.main-content-area2 .content-section2').forEach(section => {
            section.classList.remove('show');
            section.classList.add('hide');
        });

        // Show the content block that matches the clicked title
        const matchedSection = document.getElementById(clickedTitle);
        if (matchedSection) {
            matchedSection.classList.remove('hide');
            matchedSection.classList.add('show');
        }
    }



        function searchPage() {
        const query = document.getElementById("searchQuery").value.toLowerCase().trim();

        // Reset all sections
        document.querySelectorAll('.main-content-area2 .content-section2').forEach(section => {
            section.classList.remove('show');
        section.classList.add('hide');
        });

        if (query === "") return;

        let foundMatch = false;

        // Loop through each content section
        document.querySelectorAll('.main-content-area2 .content-section2').forEach(section => {
            const title = section.querySelector('h2')?.textContent.toLowerCase() || "";
        const bodyText = section.textContent.toLowerCase();

        if (title.includes(query) || bodyText.includes(query)) {
            section.classList.add('show');
        section.classList.remove('hide');
        if (!foundMatch) {
            section.scrollIntoView({ behavior: "smooth", block: "start" });
        foundMatch = true;
                }
            }
        });

        if (!foundMatch) {
            alert("No matching content found.");
        }
    }
    
    
    
    
    let mybutton = document.getElementById("myBtn");

    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            mybutton.style.display = "block";
        } else {
            mybutton.style.display = "none";
        }
    }

    function topFunction() {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
    }



</script>

