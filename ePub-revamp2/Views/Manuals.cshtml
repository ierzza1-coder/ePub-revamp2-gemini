    (function () {
        // Only run on manual pages
        if (window.location.pathname.startsWith('/manual')) {
            const currentManual = {
                url: window.location.pathname,
                title: document.title,
                time: new Date().toISOString()
            };

            // Get existing recent manuals
            let recent = JSON.parse(localStorage.getItem('recentManuals') || '[]');

            // Remove duplicates by URL
            recent = recent.filter(m => m.url !== currentManual.url);

            // Add to beginning
            recent.unshift(currentManual);

            // Limit to 5 recent items
            if (recent.length > 5) {
                recent = recent.slice(0, 5);
            }

            // Save back to localStorage
            localStorage.setItem('recentManuals', JSON.stringify(recent));
        }
    })();

    //display all docuemnt
    loadManualsUnder1207()


    ////display star document
    $(document).ready(function () {
        const container = $('.doc-list-star');
        container.html('<div class="doc-list-star"><div class="doc-header"><div class="doc-title">Document Name</div><div class="doc-date">Published Date</div></div> </div > ');

        currentCulture = document.getElementById("currentCultureSpan").textContent;




        if (currentCulture == "pbb") {

            // Get list of starred IDs
            const starred = JSON.parse(localStorage.getItem('starredManuals') || '[]');

            if (starred.length === 0) {
                container.html('<p>No starred documents.</p>');
                return;
            }

            // Clear container for results
            /*container.empty();*/


            // Loop through each ID and call the API
            starred.forEach(id => {
                $.get(`/umbraco/api/starred/getmanualcontentbyid?id=${id}`, function (res) {
                    // Append result to container
                    container.append(`<a href="${res.url}" class="doc-item" style="text-decoration:none; cursor:pointer;" data-title="${res.name}">
                 <div class="doc-title" style="text-decoration:none; color:rgb(51, 51, 51);">${res.name}</div>
                    <div class="doc-date">${res.updateDate}</div>
                 </a>
            `);
                }).fail(() => {
                    container.append(`<p style="color:red;">Failed to load document with ID ${id}</p>`);
                });
            });

        }




        else if (currentCulture == "pibb") {

            // Get list of starred IDs
            const starred = JSON.parse(localStorage.getItem('starredManualsPibb') || '[]');

            if (starred.length === 0) {
                container.html('<p>No starred documents.</p>');
                return;
            }

            // Clear container for results
            /*container.empty();*/


            // Loop through each ID and call the API
            starred.forEach(id => {
                $.get(`/umbraco/api/starred/getmanualcontentbyid?id=${id}`, function (res) {
                    // Append result to container
                    container.append(`<a href="${res.url}" class="doc-item" style="text-decoration:none; cursor:pointer;" data-title="${res.name}">
         <div class="doc-title" style="text-decoration:none; color:rgb(51, 51, 51);">${res.name}</div>
            <div class="doc-date">${res.updateDate}</div>
         </a>
    `);
                }).fail(() => {
                    container.append(`<p style="color:red;">Failed to load document with ID ${id}</p>`);
                });
            });

        }








        //click nav

        $('.starred').on('click', function (e) {

            if ($(this).hasClass('active')) {
                e.preventDefault(); // stops link behavior
                return; // stops further actions
            }

            $('.starredDoc').show()
            $('.show').hide()

            $('.show').addClass('hide');
            $('.show').removeClass('show');
            $('.starredDoc').removeClass('hide');
            $('.starredDoc').addClass('show');

            $('.active').removeClass('active');
            $('.starred').addClass('active');


        })

        $('.all').on('click', function (e) {

            if ($(this).hasClass('active')) {
                e.preventDefault(); // stops link behavior
                return; // stops further actions
            }

            $('.allDoc').show()
            $('.show').hide()

            $('.show').addClass('hide');
            $('.show').removeClass('show');
            $('.allDoc').removeClass('hide');
            $('.allDoc').addClass('show');

            $('.active').removeClass('active');
            $('.all').addClass('active');

            $('.doc-item-wrapper').show()
        })


        $('.recent').on('click', function (e) {

            if ($(this).hasClass('active')) {
                e.preventDefault(); // stops link behavior
                return; // stops further actions
            }

            $('.recentDoc').show()
            $('.show').hide()

            $('.show').addClass('hide');
            $('.show').removeClass('show');
            $('.recentDoc').removeClass('hide');
            $('.recentDoc').addClass('show');

            $('.active').removeClass('active');
            $('.recent').addClass('active');
        })


    });



    document.addEventListener("DOMContentLoaded", function () {

        $(".allManuals").on('click', function () {
            $(".recented").hide();
            $(".starred").hide();

        });

        $(".lessManuals").on('click', function () {
            $(".recented").show();
            $(".starred").show();

        });

    });

    document.addEventListener("DOMContentLoaded", function () {
        // Initially hide all except first 2 manual-item
        const $manualsContainer = $('.manuals-container');
        const $items = $manualsContainer.find('.manual-item');

        if ($items.length > 2) {
            $items.slice(2).hide();
            $('.show-more-btn').show(); // Show the Show More button
        }

        $('.show-more-btn').on('click', function () {
            $items.slideDown();
            $(this).hide();
            $('.show-less-btn').show();
        });

        $('.show-less-btn').on('click', function () {
            $items.slice(2).slideUp();
            $(this).hide();
            $('.show-more-btn').show();
        });
    });









    document.addEventListener("DOMContentLoaded", function () {
        const $manualsContainer = $('.manuals-container');
        const $items = $manualsContainer.find('.manual-item');

        // Initially show only 2
        if ($items.length > 2) {
            $items.slice(2).hide();
            $('.show-more-btn').show();
        }

        // Show More
        $('.show-more-btn').on('click', function () {
            $items.slideDown();
            $('.sort-container').fadeIn(); // Show sort dropdown
            $(this).hide();
            $('.show-less-btn').show();
        });

        // Show Less
        $('.show-less-btn').on('click', function () {
            $items.slice(2).slideUp();
            $('.sort-container').fadeOut(); // Hide sort dropdown
            $(this).hide();
            $('.show-more-btn').show();
        });

        // Sorting
        $('#sortManuals').on('change', function () {
            const sortOrder = $(this).val(); // asc or desc
            const sortedItems = $items.sort(function (a, b) {
                const titleA = $(a).find('.title-text').text().toLowerCase();
                const titleB = $(b).find('.title-text').text().toLowerCase();
                return sortOrder === 'asc' ? titleA.localeCompare(titleB) : titleB.localeCompare(titleA);
            });

            // Append sorted items
            $manualsContainer.html(sortedItems);
        });
    });


    document.addEventListener("DOMContentLoaded", function () {
        const $manualsContainer = $('.manuals-container');

        $(document).on('click', '.alphabet-btn', function () {
            const letter = $(this).data('letter');
            const $manuals = $manualsContainer.find('.manual-item');

            if (letter === 'all') {
                $manuals.show();
            } else {
                $manuals.each(function () {
                    const title = $(this).data('title')?.toLowerCase();
                    if (title && title.startsWith(letter.toLowerCase())) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Reset pagination buttons
            $('.show-less-btn').hide();
            $('.show-more-btn').show();
        });
    });


    let mybutton = document.getElementById("myBtn");

    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            mybutton.style.display = "block";
        } else {
            mybutton.style.display = "none";
        }
    }

    function topFunction() {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
    }



    //search filter
    document.getElementById("searchQuery").addEventListener("input", function () {
    const searchText = this.value.toLowerCase();
    const manuals = document.querySelectorAll(".doc-item-wrapper");

    manuals.forEach(wrapper => {
        const mainTitle = wrapper.querySelector("a").textContent.toLowerCase();
        const children = wrapper.querySelectorAll(".doc-children .doc-item div:first-child");
        let matchFound = mainTitle.includes(searchText);

        // If not found in parent, check in children
        if (!matchFound) {
            children.forEach(child => {
                if (child.textContent.toLowerCase().includes(searchText)) {
                    matchFound = true;
                }
            });
        }

        // Show or hide wrapper
        wrapper.style.display = matchFound ? "" : "none";
    });
    });


