<link rel="stylesheet" href="@Url.Content("~/css/category-style.css")">

<style>

    .main-category-list {
        background-color: #fff;
        border: 1px solid #eee;
        border-radius: 5px;
        margin-bottom: 10px;
        padding: 20px 20px;
        display: flex;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        flex-direction: column;
        border-radius: 24px;
    }


    .manuals-wrapper {
        background-color: #fff;
        border: 1px solid #eee;
        border-radius: 5px;
        margin-bottom: 10px;
        padding: 20px 20px;
        display: flex;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        flex-direction: column;
        border-radius: 16px;
        margin-right: 60px;
    }

    .manuals-wrapper2 {
        background-color: #fff;
        border: 1px solid #eee;
        border-radius: 5px;
        margin-bottom: 10px;
        padding: 20px 20px;
        display: flex;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        flex-direction: column;
        border-radius: 16px;
    }

    .manual-item {
        background-color: #FAFBFC;
        border: 1px solid #eee;
        border-radius: 5px;
        margin-bottom: 10px;
        padding: 20px 20px;
        display: flex;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        flex-direction: column;
        border-radius: 24px;
        /*        width: 350px;*/
    }

    .starred-documents {
        display: flex;
        gap: 30px;
        flex-wrap: wrap;
    }

    .recent-manual {
        display: flex;
        gap: 30px;
    }

    .ghost-container {
        margin-left: 2px;
        position: absolute;
        top: 23%;
    }

    .allManuals {
        padding: 12px 20px;
        background-color: #004080;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1em;
        font-weight: bold;
        height: 60px;
