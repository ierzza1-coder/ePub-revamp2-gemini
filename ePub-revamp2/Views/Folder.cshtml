                </div>-->
                
                
                




            <!--</div>-->

            <div class="help-content">
                <div class="search-container" style="margin-top:50px; display:flex;">
                    <input type="text" id="searchInput" placeholder="Search Question" oninput="showDropdown()" onkeypress="handleSearchEnter(event)">
                    <ul id="searchDropdown" style="/* padding-top: 100px; */ margin-top: 50px; width: 633px; " class="absolute z-10 w-full bg-white border border-gray-300 rounded shadow max-h-60 overflow-auto hidden">
                    </ul>
                    <span class="search-icon-input">
