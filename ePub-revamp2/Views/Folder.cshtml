    <footer class="footer">
        Copyright © 2025 Public Bank Berhad
    </footer>

    <script>
        function toggleAccordion(element) {
            //const header = element;
            //const content = header.nextElementSibling;

            //header.classList.toggle('expanded');
            //if (content.classList.contains('open')) {
            //    content.classList.remove('open');
            //    content.style.maxHeight = null;
            //} else {
            //    content.classList.add('open');
            //    content.style.maxHeight = content.scrollHeight + 'px';
            //}
        }

        // Auto-expand the first accordion item on page load as per the image
        document.addEventListener('DOMContentLoaded', () => {
            const firstAccordionHeader = document.querySelector('.accordion-item .accordion-header');
            if (firstAccordionHeader) {
                toggleAccordion(firstAccordionHeader);
            }
        });


        //back to top button
        let mybutton = document.getElementById("myBtn");

        window.onscroll = function () { scrollFunction() };

        function scrollFunction() {
            if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                mybutton.style.display = "block";
            } else {
                mybutton.style.display = "none";
            }
        }

        function topFunction() {
            document.body.scrollTop = 0;
            document.documentElement.scrollTop = 0;
        }


        document.addEventListener('DOMContentLoaded', function () {
            const toggles = document.querySelectorAll('.has-children');

            toggles.forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    const nestedList = this.nextElementSibling;
                    if (nestedList && nestedList.classList.contains('nested-nav-link')) {
                        nestedList.style.display = nestedList.style.display === 'block' ? 'none' : 'block';
                    }
                });
            });
        });


        function handleSearch(event) {
            if (event.key === 'Enter') {
                const input = document.getElementById("searchInput").value.toLowerCase().trim();
                if (!input) return;

                const paragraphs = document.querySelectorAll("p");
                let foundSection = null;

                paragraphs.forEach(p => {
                    if (p.textContent.toLowerCase().includes(input) && !foundSection) {
                        // Find the closest section with an ID (e.g., #search2, #manual1, etc.)
                        let section = p.closest(".accordion-item, .main-content-area");
                        while (section && !section.id) {
                            section = section.previousElementSibling || section.parentElement;
                        }

                        if (section && section.id) {
                            foundSection = section;
                        }
                    }
                });
                console.log(foundSection)
                if (foundSection) {
                    document.getElementById(foundSection.id).scrollIntoView({ behavior: 'smooth' });

                    // Optional highlight
                    foundSection.classList.add("ring", "ring-blue-300");
                    setTimeout(() => {
                        foundSection.classList.remove("ring", "ring-blue-300");
                    }, 2000);

                } else {
                    alert("No matching paragraph found.");
                }
            }
        }

        function handleSearchEnter(event) {
            if (event.key === 'Enter') {
                const dropdown = document.getElementById("searchDropdown");
                if (dropdown.firstChild) {
                    dropdown.firstChild.click(); // Simulate click on first result
                }
            }
        }

        function showDropdown() {
            const input = document.getElementById("searchInput").value.toLowerCase().trim();
            const dropdown = document.getElementById("searchDropdown");
            dropdown.innerHTML = "";

            if (!input) {
                dropdown.classList.add("hidden");
                return;
            }

            const paragraphs = document.querySelectorAll("p");
            let results = [];

            paragraphs.forEach(p => {
                const text = p.textContent.toLowerCase();
                if (text.includes(input)) {
                    const section = p.closest(".accordion-item, .main-content-area");

                    console.log(section);
                    const sectionId = section?.id || "";
                    const heading = section?.querySelector("span")?.textContent || "Untitled Section";

                    const previewStart = text.indexOf(input);
                    const preview = p.textContent.substring(
                        Math.max(previewStart - 20, 0),
                        previewStart + input.length + 20
                    );

                    results.push({ sectionId, heading, preview });
                }
            });

            if (results.length === 0) {
                dropdown.classList.add("hidden");
                return;
            }

            

            results.forEach(res => {

                console.log(res);

                const li = document.createElement("li");
                li.className = "px-4 py-2 hover:bg-gray-100 cursor-pointer text-sm text-left";
                li.innerHTML = `
                <strong class="block text-gray-800">${res.heading}</strong>
                <span class="text-gray-600">${res.preview.replace(new RegExp(input, 'gi'), match => `<mark>${match}</mark>`)}</span>
            `;
                li.onclick = () => {
                    document.getElementById(res.sectionId)?.scrollIntoView({ behavior: 'smooth' });

                    // Optional: highlight the section briefly
                    const el = document.getElementById(res.sectionId);
                    el?.classList.add("ring", "ring-blue-300");
                    setTimeout(() => el?.classList.remove("ring", "ring-blue-300"), 2000);

                    dropdown.classList.add("hidden");
                };
                dropdown.appendChild(li);
            });

            dropdown.classList.remove("hidden");
        }



    </script>


</body>